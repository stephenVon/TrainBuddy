/* Interaction System 2.0：训练/约课作用域，色板对齐暖白自然绿 */
.interaction-scope {
  --ix-ink: var(--ink);
  --ix-muted: var(--muted);
  --ix-surface: var(--surface);
  --ix-line: var(--line);
  --ix-accent: var(--accent);
  --ix-soft: var(--ix-soft);
  --ix-error: var(--danger);
  --ix-fast: 100ms;
  --ix-state: 200ms;
  --ix-panel: 280ms;
}
.ix-preference {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
  margin: 16rpx 0;
}
.ix-error {
  color: var(--danger);
  background: var(--danger-bg);
  padding: 20rpx;
  border-radius: 16rpx;
  margin: 16rpx 0;
}
.ix-focus {
  border-left: 6rpx solid var(--accent);
}
.ix-tools {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0;
}
.ix-tools button {
  margin: 0;
  min-height: 88rpx;
}
.interaction-scope .primary {
  background: var(--ix-accent);
  color: var(--on-accent);
  border-radius: 999rpx;
  min-height: 44px;
}
.interaction-scope .secondary {
  background: var(--surface);
  color: var(--ix-ink);
  border: 1rpx solid var(--ix-line);
  border-radius: 999rpx;
  min-height: 44px;
}
.interaction-scope .aset {
  background: var(--surface-raised);
}
.ix-mask {
  position: fixed;
  inset: 0;
  background: rgba(28, 61, 46, 0.44);
  z-index: 100;
}
.ix-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background: var(--surface);
  color: var(--ink);
  border-radius: 40rpx 40rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  max-height: 82vh;
  animation: ix-enter 280ms var(--ease-spring, cubic-bezier(0.34, 1.4, 0.64, 1));
}
.ix-sheet-scroll {
  max-height: 60vh;
}
.ix-sheet .head {
  margin-top: 0;
}
.ix-reduced .ix-sheet {
  animation: none;
}
@keyframes ix-enter {
  from {
    transform: translateY(32rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
.ix-sort-row {
  background: var(--surface);
  border-bottom: 1rpx solid var(--line);
  padding: 20rpx 0;
}
.ix-dragging {
  opacity: 0.65;
  background: var(--ix-soft);
}
.ix-handle {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  color: var(--muted);
  border: 1rpx dashed var(--line);
  padding: 0 20rpx;
  border-radius: 16rpx;
}

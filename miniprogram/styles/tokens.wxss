/* 练搭子 · 暖白自然绿（保留 Interaction v2 / 全站落地所需语义 token） */
page {
  --ink: #25352c;
  --muted: #6e7c72;
  --paper: #fafbf7;
  --surface: #ffffff;
  --surface-raised: #f1f5ed;
  --line: #e0e7dc;
  --accent: #28744e;
  --lime: #28744e;
  --purple: #8478a5;
  --signal: #c7e8a8;
  --graphite: #1c3d2e;
  --positive: #28744e;
  --radius-card: 36rpx;
  --radius-ctl: 28rpx;
  --radius-pill: 999rpx;
  --ease-spring: cubic-bezier(0.34, 1.4, 0.64, 1);
  --shadow-soft: 0 8rpx 28rpx rgba(40, 116, 78, 0.08);
  --ix-ink: #25352c;
  --ix-muted: #6e7c72;
  --ix-surface: #ffffff;
  --ix-line: #e0e7dc;
  --ix-accent: #28744e;
  --ix-soft: #eef4e9;
  --ix-error: #b42332;
  --ix-fast: 100ms;
  --ix-state: 200ms;
  --ix-panel: 280ms;
  --danger: #b42332;
  --warning: #8a5a26;
  --coach-radius: 20rpx;
  --coach-control-radius: 14rpx;
  --coach-space: 24rpx;
  /* V1.5 皮肤系统补充 token（浅色值 = 原硬编码值，白色皮肤外观不变） */
  --on-accent: #ffffff;
  --hero-ink: #f3f6f1;
  --hero-muted: #c5d6c8;
  --disabled-bg: #e7eee4;
  --disabled-line: #d7e0d4;
  --disabled-ink: #7a8a7e;
  --ok-bg: #e8f5ee;
  --ok-line: #b2d9c5;
  --ok-ink: #19704c;
  --progress-track: #dce3ed;
  --danger-bg: #fff1f2;
  --danger-line: #f1cbd0;
  --danger-ink: #a52b3b;
  --tint-1: #f7f9f2;
  --tint-2: #f1f4ee;
  --green-soft: #e6f0e4;
  --green-strong: #d4e3cc;
  --deep-green: #486540;
  --muted-2: #8a958b;
  --ink-2: #3a4540;
  --blue-tint: #f7f9fc;
  --blue-tint-2: #dfe7ff;
  --blue-line: #dce2e8;
  --blue-soft: #b7c6f9;
  --blue-muted: #738093;
  --blue-ink: #526071;
  --warm-ink: #9a6b45;
  --warm-tint: #fff3e3;
}

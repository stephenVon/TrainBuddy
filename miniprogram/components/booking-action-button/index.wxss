:host { display: block; width: 100%; }
.submit {
  background: var(--ix-accent, var(--accent));
  color: var(--on-accent);
  border-radius: 16rpx;
  min-height: 96rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: opacity var(--ix-state, 200ms) ease, transform var(--ix-fast, 100ms) ease;
}
.submit::after { border: 0; }
.submit:active { transform: scale(.99); opacity: .92; }
.submit.is-disabled {
  background: var(--disabled-bg, var(--disabled-bg));
  color: var(--disabled-ink, var(--ix-muted, var(--muted)));
  transform: none;
}
.submit.submitted,
.submit.confirmed {
  background: var(--ok-soft, var(--ok-bg));
  color: var(--ok-ink, var(--ok-ink));
}
.error {
  font-size: 24rpx;
  color: var(--ix-error, var(--danger, var(--danger)));
  margin-top: 16rpx;
}
.reduced .submit { transition: none; transform: none; }
@media (prefers-reduced-motion: reduce) {
  .submit { transition: none; transform: none; }
}

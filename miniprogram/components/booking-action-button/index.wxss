:host{display:block;width:100%}.submit{background:var(--ix-accent, var(--accent));color:var(--on-accent);border-radius:16rpx;min-height:96rpx;font-size:28rpx;font-weight:600;transition:opacity var(--ix-state, 200ms) ease,transform var(--ix-fast, 100ms) ease}.submit::after{border:0}.submit:active{transform:scale(.99)}.submit.is-disabled{background:var(--blue-tint);color:var(--ix-muted, var(--blue-ink))}.submit.submitted,.submit.confirmed{background:var(--ok-bg);color:var(--deep-green)}.error{font-size:24rpx;color:var(--danger);margin-top:16rpx}.reduced .submit{transition:none;transform:none}

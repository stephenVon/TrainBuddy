:host { display:block; }
view,text,button,textarea { box-sizing:border-box; }
button { margin:0; font:inherit; line-height:1.4; padding:0; border:0; }
button::after { border:none; }
.voice-input { padding:24rpx; border:1rpx solid var(--line,#e0e7dc); border-radius:20rpx; background:var(--surface,#fff); color:var(--ink,#25352c); }
.voice-active { border-color:var(--accent,#28744e); }
.voice-heading { display:flex; align-items:center; gap:12rpx; justify-content:space-between; font-size:26rpx; font-weight:600; }
.channel { color:var(--muted,#6e7c72); font-size:20rpx; font-weight:400; }
.voice-text { display:block; width:100%; min-height:96rpx; max-height:300rpx; margin:16rpx 0; padding:0; font-size:28rpx; line-height:1.6; border:0; background:transparent; }
.voice-controls { border-top:1rpx solid var(--line,#e0e7dc); padding:20rpx 0; }
.voice-start,.voice-running,.voice-waiting { display:flex; align-items:center; gap:16rpx; min-height:88rpx; }
.voice-copy { flex:1; min-width:0; }
.mic-button { flex:none; display:flex; align-items:center; justify-content:center; width:88rpx; height:88rpx; border-radius:24rpx; background:var(--surface-raised,#f1f5ed); }
.status { display:block; font-size:25rpx; line-height:1.6; }
.hint { display:block; color:var(--muted,#6e7c72); font-size:22rpx; line-height:1.6; font-weight:400; }
.live { display:flex; align-items:center; gap:10rpx; }
.record-dot { width:12rpx; height:12rpx; border-radius:50%; background:var(--danger,#b42332); flex:none; }
.pulsing { animation:record-pulse 1200ms ease-in-out infinite; }
.clock { display:block; margin-top:8rpx; font-size:36rpx; font-weight:600; font-variant-numeric:tabular-nums; }
.clock .hint { display:inline; }
.control-button { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6rpx; min-width:88rpx; min-height:88rpx; padding:8rpx; border-radius:14rpx; color:var(--ink,#25352c); background:var(--surface-raised,#f1f5ed); font-size:22rpx; }
.stop-button { color:var(--danger,#b42332); background:#fff1f2; }
.spinner { flex:none; width:28rpx; height:28rpx; border:3rpx solid var(--line,#e0e7dc); border-top-color:var(--accent,#28744e); border-radius:50%; animation:spin 900ms linear infinite; }
.parse-button { width:100%; min-height:44px; padding:20rpx 16rpx; margin-top:16rpx; border:1rpx solid var(--line,#e0e7dc); border-radius:14rpx; background:var(--surface,#fff); color:var(--accent,#28744e); font-size:26rpx; font-weight:600; }
.text-action { padding:16rpx 0; min-height:44px; text-align:left; color:var(--accent,#28744e); background:transparent; font-size:24rpx; }
button[disabled] { opacity:.45; }
button:active { opacity:.75; }
@keyframes record-pulse { 50% { opacity:.35; } }
@keyframes spin { to { transform:rotate(360deg); } }
.reduced .pulsing,.reduced .spinner { animation:none; }
@media (prefers-reduced-motion:reduce) { .pulsing,.spinner { animation:none; } }
@media (max-width:340px) { .voice-input { padding:20rpx; } .voice-running { flex-wrap:wrap; } .voice-copy { min-width:140rpx; } }

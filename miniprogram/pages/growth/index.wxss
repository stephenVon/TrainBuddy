.growth-page { padding-top: 4rpx; }

.goal-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 20rpx 0;
  padding: 28rpx 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}
.goal-ring-wrap { flex: none; }
.goal-ring {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--progress-track);
  transition: background var(--ix-panel) ease;
}
.goal-ring-ready { /* 仅数据就绪后允许一次过渡 */ }
.goal-ring-hole {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: var(--surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.goal-ring-value {
  font-size: 36rpx;
  font-weight: 750;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}
.goal-ring-unit { margin-top: 6rpx; font-size: 18rpx; color: var(--muted); }
.goal-copy { flex: 1; min-width: 0; }
.goal-copy .eyebrow { margin-top: 0; }
.goal-line { margin-top: 8rpx; font-size: 22rpx; color: var(--muted); line-height: 1.5; }
.goal-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 18rpx;
}
.goal-metric-value {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--ink);
}
.goal-metric-label { display: block; margin-top: 4rpx; font-size: 18rpx; color: var(--muted); }

.growth-volume { margin-top: 12rpx; }

.chart {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  height: 260rpx;
  padding-top: 28rpx;
  border-radius: var(--radius-card);
  box-shadow: none;
}
.bar-col {
  flex: 1;
  min-width: 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}
.bar-value {
  font-size: 18rpx;
  color: var(--muted);
  margin-bottom: 6rpx;
  font-variant-numeric: tabular-nums;
}
.bar {
  width: 100%;
  max-width: 44rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  margin-bottom: 8rpx;
  min-height: 8rpx;
  background: var(--accent);
  transition: height var(--ix-panel) ease;
}
.bar-zero { background: var(--surface-raised); }
.bar-label { font-size: 20rpx; color: var(--muted); }

.highlight-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}
.highlight-card {
  min-width: 0;
  padding: 18rpx 14rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
}
.highlight-card .card-title {
  margin: 0;
  font-size: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.highlight-value {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--ink);
}
.highlight-value text { font-size: 20rpx; color: var(--muted); font-weight: 500; }

.body-entry {
  display: flex;
  align-items: center;
  gap: 22rpx;
  width: 100% !important;
  margin-top: 28rpx;
  padding: 26rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
  text-align: left;
  box-shadow: none;
}
.body-entry-symbol {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 7rpx;
  width: 68rpx;
  height: 68rpx;
  padding: 17rpx;
  background: var(--soft);
  border-radius: 20rpx;
}
.body-entry-symbol view { width: 8rpx; border-radius: 4rpx; background: var(--accent); height: 22rpx; }
.body-entry-symbol view:nth-child(2) { height: 34rpx; }
.body-entry-symbol view:nth-child(3) { height: 27rpx; }
.body-entry-title { font-size: 29rpx; font-weight: 600; color: var(--ink); }
.body-entry-sub { font-size: 23rpx; color: var(--muted); margin-top: 6rpx; }
.body-entry-arrow { font-size: 38rpx; color: var(--muted); }
.card-press { transition: opacity var(--ix-fast) ease; }
.card-press:active { opacity: .9; }

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx 20rpx;
  margin-bottom: 16rpx;
}
.leg {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--muted);
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--soft);
}
.dot-workout { background: var(--accent); }
.dot-rest { background: #9a90b0; }
.dot-meal { background: #e9ac45; }
.dot-body { background: #6aa6a3; }
.dot-measure { background: #5b7c99; }
.dot-incomplete { background: #d86d62; }

.cal-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}
.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}
.cal-cell {
  min-height: 88rpx;
  border-radius: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  padding: 8rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cal-cell.empty { background: transparent; border-color: transparent; }
.cal-cell.today { border-color: var(--ok-line); }
.cal-cell.selected { background: var(--soft); border-color: var(--accent); }
.cal-day { font-size: 24rpx; font-weight: 600; }
.cal-dots {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  justify-content: center;
  margin-top: 6rpx;
}
.cal-dots .dot { width: 10rpx; height: 10rpx; }

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}
.day-panel { margin-top: 16rpx; }
.day-panel-btn { width: 100% !important; margin-top: 12rpx; }
.record-card { margin-top: 12rpx; }

.growth-tools { border-top: 1rpx solid var(--line); margin-top: 8rpx; }
.growth-tool {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  min-height: 112rpx;
  padding: 24rpx 8rpx;
  background: transparent;
  border-bottom: 1rpx solid var(--line);
  text-align: left;
  border-radius: 0;
}

@media (max-width: 340px) {
  .goal-card { flex-direction: column; align-items: flex-start; }
  .highlight-row { grid-template-columns: 1fr; }
}
@media (prefers-reduced-motion: reduce) {
  .goal-ring, .bar, .card-press { transition: none; }
}
.ui-reduced .goal-ring,
.ui-reduced .bar,
.ix-reduced .goal-ring,
.ix-reduced .bar { transition: none; }

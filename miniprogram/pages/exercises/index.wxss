.page-solo {
  padding-bottom: 60rpx;
}

.chip-row {
  white-space: nowrap;
  margin: 20rpx 0;
}

.chip {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--muted);
}

.chip.on {
  background: #eef4e9;
  border-color: #b7c6f9;
  color: var(--ink);
}

.library-row {
  align-items: center;
}

.library-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #eef4e9;
  flex-shrink: 0;
  margin-right: 16rpx;
}

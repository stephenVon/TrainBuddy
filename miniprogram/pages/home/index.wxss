@import "../../styles/coach.wxss";
.home-page { padding-top:4rpx; }
.coach-home-row { display:flex; align-items:center; gap:20rpx; width:100% !important; padding:24rpx; background:var(--surface); border:1rpx solid var(--line); border-radius:18rpx; text-align:left; }
.home-empty { padding:30rpx 24rpx; background:var(--surface); border:1rpx dashed var(--blue-line); border-radius:18rpx; color:var(--muted); }
.quick-grid { display:flex; flex-direction:column; border-top:1rpx solid var(--line); }
.quick-card { display:flex; align-items:center; gap:20rpx; width:100% !important; padding:24rpx 0; border-bottom:1rpx solid var(--line); border-radius:0; text-align:left; }
.course-row { display:flex; align-items:center; gap:20rpx; width:100% !important; padding:24rpx 0; border-bottom:1rpx solid var(--line); text-align:left; }
.course-time { font-size:30rpx; font-weight:700; font-variant-numeric:tabular-nums; flex:none; border-left:4rpx solid var(--accent); padding-left:16rpx; }
.workbench-record { width:100% !important; min-height:104rpx; margin:24rpx 0; border-radius:16rpx; }
.workbench-entry { padding:24rpx 0 12rpx; }
.record-launch { display:flex; align-items:center; gap:24rpx; width:100% !important; min-height:168rpx; padding:28rpx; border-radius:24rpx; background:var(--accent); color:var(--surface); text-align:left; transition:opacity var(--ix-fast) ease; }
.record-launch:active { opacity:.88; }
.record-launch-icon { display:flex; align-items:center; justify-content:center; flex:none; width:88rpx; height:88rpx; border:1rpx solid rgba(255,255,255,.25); border-radius:24rpx; }
.record-launch-copy { flex:1; min-width:0; }
.record-launch-title { display:block; font-size:36rpx; font-weight:650; line-height:1.4; }
.record-launch-hint { display:block; margin-top:8rpx; font-size:23rpx; line-height:1.6; opacity:.86; }
.course-summary { display:flex; flex:1; min-width:0; align-items:center; gap:20rpx; text-align:left; background:transparent; padding:0; border-radius:0; }
.course-person { flex:1; min-width:0; }
.workbench .course-time { align-self:flex-start; border:0; padding:4rpx 0; width:104rpx; font-size:30rpx; }
.workbench .course-row .card-title { margin-bottom:4rpx; }
.course-status { display:inline-block; margin-top:6rpx; font-size:22rpx; color:var(--muted); }
.course-record { flex:none; padding:14rpx 20rpx; }
.pending-entry { display:flex; align-items:center; width:100%; min-height:44px; padding:16rpx 0; color:var(--accent); font-size:25rpx; text-align:left; border-bottom:1rpx solid var(--line); }
.aux-tools { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; }
.aux-tools button { display:flex; align-items:center; gap:12rpx; width:100% !important; min-height:88rpx; min-width:0; padding:16rpx 0; text-align:left; }
.aux-tools text { flex:1; font-size:25rpx; }
@media (max-width:340px) { .record-launch { padding:24rpx; gap:16rpx; } .record-launch-hint { font-size:22rpx; } .aux-tools { grid-template-columns:1fr; gap:0; } }
@media (prefers-reduced-motion:reduce) { .record-launch { transition:none; } }

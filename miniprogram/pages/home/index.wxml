<view class="page home-page {{role === 'coach' ? 'coach-scope workbench' : ''}} {{skinClass}}">
  <view class="top"><view><view class="title">{{role === 'coach' ? '工作台' : '我的课程'}}</view><view class="sub">{{todayLabel}}</view></view><button class="msg-btn" bindtap="goProfile" aria-label="账户与身份设置">{{avatarChar}}</button></view>
  <view class="ui-state" wx:if="{{loading}}">正在同步课程…</view>
  <view class="ui-state ui-state-error" wx:if="{{syncError || bookingError}}">{{syncError || bookingError}}<button class="link" bindtap="refreshPage">重新加载</button></view>
  <block wx:if="{{role === 'coach' && canSwitchCoach}}">
    <view class="workbench-entry">
      <button class="record-launch" bindtap="goRecord" aria-label="记录训练，先选择学员，再开始语音或文字录入">
        <view class="record-launch-icon"><ui-icon name="mic" tone="white" size="52"/></view>
        <view class="record-launch-copy"><text class="record-launch-title">记录训练</text><text class="record-launch-hint">选定学员 · 语音或文字录入</text></view>
        <ui-icon name="chevron" tone="white" size="32"/>
      </button>
    </view>
    <button class="pending-entry" wx:if="{{pendingCoachCount}}" bindtap="goPendingBooking">待确认预约 {{pendingCoachCount}} 条 ›</button>
    <view class="head"><view class="head-title">今日课程</view><button class="link" bindtap="goBooking">完整日程 ›</button></view>
    <view class="course-row" wx:for="{{todayCourses}}" wx:key="booking_id"><button class="course-summary" data-id="{{item.booking_id}}" bindtap="goCourse"><view class="course-time">{{item.startLabel}}</view><view class="course-person"><view class="card-title">{{item.student_name}}</view><view class="sub">{{item.course_name}}</view><text class="course-status">{{item.statusLabel}}</text></view></button><button class="secondary course-record" data-id="{{item.booking_id}}" bindtap="goCourseRecord">记录</button></view>
    <view class="quiet-empty" wx:if="{{!todayCourses.length && !loading && !bookingError && !syncError}}">今天暂无课程，仍可为已绑定学员记录训练。</view>
    <view class="head"><view class="head-title">辅助工具</view></view>
    <view class="aux-tools"><button bindtap="goPosture"><ui-icon name="body" size="36"/><text>体态评估</text><ui-icon name="chevron" size="26"/></button><button bindtap="goInvite"><ui-icon name="invite" size="36"/><text>邀请学员</text><ui-icon name="chevron" size="26"/></button></view>
  </block>
  <block wx:elif="{{role === 'student'}}">
    <view class="head"><view class="head-title">下一次课程</view></view>
    <button class="course-row" wx:if="{{nextBooking}}" bindtap="goNextBooking"><view class="grow"><view class="card-title">{{nextBooking.dateKey}} {{nextBooking.startLabel}}</view><view class="sub">{{coachName}} · {{nextBooking.course_name}}</view><text class="tag">{{nextBooking.statusLabel}}</text></view><text>查看 ›</text></button>
    <view class="home-empty" wx:elif="{{!loading && !bookingError}}"><view class="card-title">{{hasBinding ? '还没有下一次课程' : '连接你的教练'}}</view><view class="sub">{{hasBinding ? '查看可约时间，安排下一次训练。' : '绑定后接收课后训练表和教练反馈。'}}</view></view>
    <button class="primary workbench-record" wx:if="{{hasBinding}}" bindtap="goBooking">查看可约时间与我的预约</button><button class="primary workbench-record" wx:else bindtap="goBind">绑定教练</button>
    <view class="head"><view class="head-title">课后训练表与反馈</view></view><button class="coach-home-row" bindtap="goCoach"><view class="grow"><view class="card-title">教练同步的训练记录</view><view class="sub">查看每组表现、动作建议与饮食点评。</view></view><text>›</text></button>
    <view class="head"><view class="head-title">自己的训练</view></view><view class="quick-grid"><button class="quick-card" bindtap="goWorkout">训练与记录 ›</button><button class="quick-card" bindtap="goGrowth">查看进展 ›</button></view>
  </block>
<bottom-nav active="home"/>
</view>

.page-solo {
  padding-bottom: 60rpx;
}

.detail-card {
  padding-top: 8rpx;
}

.detail-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0 14rpx;
  border-bottom: 1rpx solid var(--line);
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 26rpx;
}

.row:last-child {
  border-bottom: 0;
}

.k {
  color: var(--muted);
  flex-shrink: 0;
}

.v {
  font-weight: 600;
  text-align: right;
  min-width: 0;
  word-break: break-word;
}

.dates {
  white-space: nowrap;
  margin: 16rpx 0;
  width: 100%;
}

.date-btn {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx !important;
  min-width: 100rpx;
  margin-right: 12rpx !important;
  padding: 18rpx 8rpx 14rpx;
  box-sizing: border-box;
}

.date-week {
  font-size: 20rpx;
}

.date-mark {
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 16rpx;
  color: #28744e;
  font-weight: 600;
  white-space: nowrap;
}

.date-btn.is-today:not(.chosen) {
  border-color: #a5c5a7;
  background: #f4f9f1;
  color: #1f5c3d;
}

.date-btn.chosen .date-mark {
  color: rgba(255, 255, 255, 0.92);
}

.date-btn.chosen::after {
  content: '已选';
  display: block;
  margin-top: 4rpx;
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.9);
}

.change-load {
  margin: 8rpx 0 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #f7f9f2;
  color: #6e7c72;
  font-size: 24rpx;
}

.change-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.change-slot {
  width: 100% !important;
  margin: 0 !important;
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #c5dbc8;
  text-align: left;
  box-sizing: border-box;
}

.change-slot::after {
  border: none;
}

.change-slot.is-off,
.change-slot[disabled] {
  opacity: 0.5;
  border-style: dashed;
  border-color: #e0e7dc;
  background: #f7f9f2;
}

.change-slot-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8rpx;
}

.change-time {
  font-size: 26rpx;
  font-weight: 700;
  color: #25352c;
  font-variant-numeric: tabular-nums;
}

.change-mark {
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #eef4e9;
  color: #1f5c3d;
  flex-shrink: 0;
}

.change-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6e7c72;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ix-error {
  margin: 8rpx 0 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #fff5f2;
  border: 1rpx solid #e8cfc8;
  color: #a34736;
  font-size: 24rpx;
}

@media (max-width: 360px) {
  .change-grid {
    grid-template-columns: 1fr;
  }
}

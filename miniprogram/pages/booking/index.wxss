@import "../../styles/interaction.wxss";
@import "../../styles/coach.wxss";
.schedule-header { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:28rpx 0 12rpx; }
.schedule-tools { padding:20rpx; border:1rpx solid var(--line); border-radius:var(--coach-radius); background:var(--surface); }
.schedule-tools .secondary { width:100%; }
.coach-scope .seg { border-radius:16rpx; gap:4rpx; padding:6rpx; }
.coach-scope .seg-btn { min-height:44px; border-radius:12rpx; font-size:24rpx; }
.schedule-course { display:flex; align-items:center; padding:26rpx 0; border-bottom:1rpx solid var(--line); min-height:132rpx; }
.schedule-course .slot { width:100%; }
.schedule-course .time { width:100rpx; font-size:29rpx; }
.schedule-course .statuspill { max-width:140rpx; white-space:normal; }
.schedule-course .card-title { margin-bottom:4rpx; }
.schedule-course .sub { font-size:23rpx; }
.open-slots-toggle { margin-top:24rpx; max-width:none; font-weight:400; }
.coach-scope .week-col { min-width:0; border-width:1rpx; border-radius:14rpx; padding:16rpx 2rpx; }
.coach-scope .week-hd { font-size:23rpx; }
.week-day { display:block; margin-top:8rpx; font-size:28rpx; color:var(--ink); }
.dates {
  white-space: nowrap;
  margin: 26rpx 0;
  width: 100%;
}

.date-btn {
  display: inline-flex;
  margin-right: 12rpx;
}

.seg {
  display: flex;
  gap: 8rpx;
  margin: 20rpx 0;
  padding: 8rpx;
  background: var(--surface-raised);
  border-radius: 20rpx;
}

.seg-btn {
  flex: 1;
  border: 0;
  background: transparent;
  padding: 16rpx 8rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--muted);
  line-height: 1.2;
}

.seg-btn.on {
  background: var(--surface);
  color: var(--ink);
}

.week-grid {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
}

.week-col {
  flex: 1;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 16rpx 4rpx;
  text-align: center;
}

.week-hd {
  font-size: 18rpx;
  color: var(--muted);
  white-space: pre-line;
  line-height: 1.3;
}

.week-n {
  font-size: 36rpx;
  font-weight: 600;
  margin-top: 10rpx;
}

.booking-submit { background:#fff;padding:24rpx;border:1rpx solid #dce2e8;border-radius:16rpx;margin:20rpx 0; }
.booking-submit .sub { margin-bottom:16rpx; }
.slot-card-on { border-color:#28744e; box-shadow:0 0 0 4rpx rgba(40,116,78,.12); }
